      "/security": {
        "version": 1,
        "title": "WhatsApp security",
        "elements": [
          {
            "kind": "row",
            "id": "masthead",
            "children": [
              {"kind":"styled","id":"mark","text":"WhatsApp","style":{"size":18,"weight":"bold","color":"#ffffff"}},
              {
                "kind": "row",
                "id": "nav-links",
                "children": [
                  {"kind":"link","id":"nav","text":"Features","url":"http://whatsapp.com/features"},
                  {"kind":"styled","id":"nav-here","text":"Security","style":{"size":13,"weight":"bold","color":"#ffffff"}},
                  {"kind":"link","id":"nav-2","text":"Business","url":"http://whatsapp.com/business"},
                  {"kind":"link","id":"nav-3","text":"Download","url":"http://whatsapp.com/download"},
                  {"kind":"link","id":"nav-4","text":"Help","url":"http://whatsapp.com/help"},
                  {"kind":"link","id":"nav-5","text":"WhatsApp Web","url":"http://whatsapp.com/web"}
                ],
