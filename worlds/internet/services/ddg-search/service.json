      "dropbox.com": 2,
      "northwind.example": 2,
      "slack.com": 2,
      "discord.com": 3,
      "linear.app": 2
    }
  },
  "search_entries": [
    {
      "url": "http://duckduckgo.com/",
      "title": "DuckDuckGo - Privacy, simplified",
      "snippet": "Search without being tracked. Bang shortcuts such as !gh and !w jump straight to another site.",
      "vertical": "all",
      "authority": 5,
      "keywords": [
        "duckduckgo",
        "ddg",
