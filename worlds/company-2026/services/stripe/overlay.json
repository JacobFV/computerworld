                "kind": "styled",
                "id": "apa13",
                "text": "POST /v1/payment_intents\nGET  /v1/payment_intents/:id\nPOST /v1/payment_intents/:id/confirm\nPOST /v1/payment_intents/:id/capture\nPOST /v1/payment_intents/:id/cancel",
                "style": {
