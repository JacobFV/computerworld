      "accent": "#1a73e8",
      "background": "#ffffff",
      "surface": "#f1f3f4",
      "ink": "#202124",
      "muted": "#5f6368",
      "content_width": 760
    },
    "retain_history": true,
    "rank_weights": {"title": 8, "keywords": 4, "snippet": 1, "authority": 2},
    "verticals": ["all", "images", "news", "videos"],
    "about": "Google ranks a fixed index of pages by where the query matches — title first, then keywords, then the description — and adds a per-site authority bonus to anything that already matched. Ties break on the URL, so the same search always comes back in the same order.",
    "footer": [
      {"text": "Wikipedia", "url": "http://wikipedia.org/"},
      {"text": "YouTube", "url": "http://youtube.com/"},
      {"text": "Northstar", "url": "http://northstar.example/"}
    ],
    "history": {
      "alice": ["27 inch 4k usb-c monitor", "shipping atlas", "deterministic simulation"],
      "carol": ["devcon seattle tickets", "atlas launch checklist"]
    },
    "documents": {"from_file": "index/google-search.json"}
  },
