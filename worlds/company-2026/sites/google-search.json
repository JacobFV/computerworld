{
  "id": "google-search",
  "kind": "search",
  "node": "google-search",
  "domains": ["google.com", "www.google.com"],
  "port": 80,
  "initial_state": {
    "brand": "Google",
    "skin": "google",
    "header": [
      {"text": "Gmail", "url": "http://gmail.com/"},
      {"text": "Images", "url": "/search?v=images"}
