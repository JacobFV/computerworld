                    "kind": "styled",
                    "id": "inc-3-when",
                    "text": "2026-01-08 · 41 minutes",
                    "style": {
                      "size": 12,
                      "color": "#5d6b79"
                    }
                  }
                ],
                "gap": 10,
                "align": "center"
              },
              {
                "kind": "text",
                "id": "inc-3-body",
                "text": "A migration held a write lock longer than planned. Reads were unaffected throughout."
              }
            ],
            "style": {
              "background": "#ffffff",
              "border": "#dde3ea",
              "radius": 10,
              "padding": 16
            }
          },
          {
            "kind": "spacer",
            "id": "status-subscribe-gap",
            "height": 24
