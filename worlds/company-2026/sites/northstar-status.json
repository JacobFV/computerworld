            "text": "All incidents",
            "url": "/"
          },
          {
            "kind": "styled",
            "id": "inc4-title",
            "text": "INC-4 Elevated API latency",
            "style": {
              "size": 24,
              "weight": "bold",
              "color": "#16202a"
            }
          },
          {
            "kind": "row",
            "id": "inc4-meta",
            "children": [
              {
                "kind": "badge",
                "id": "inc4-tag",
                "text": "Resolved",
                "style": {
                  "size": 11,
                  "color": "#ffffff",
                  "background": "#1f883d",
                  "radius": 10,
                  "padding": 5
                }
              },
              {
                "kind": "styled",
                "id": "inc4-when",
                "text": "2026-02-19 · 12 minutes · Atlas API",
                "style": {
                  "size": 13,
                  "color": "#5d6b79"
                }
              }
            ],
            "gap": 10,
            "align": "center"
          },
          {
            "kind": "divider",
            "id": "inc4-rule"
          },
          {
            "kind": "card",
            "id": "inc4-timeline",
            "children": [
              {
                "kind": "styled",
                "id": "inc4-t1",
                "text": "14:02 UTC — Investigating",
                "style": {
                  "size": 14,
                  "weight": "bold",
                  "color": "#16202a"
                }
              },
              {
                "kind": "text",
                "id": "inc4-t1-body",
                "text": "p99 latency on the Atlas API crossed the eight second alert threshold. On-call paged."
              },
              {
                "kind": "styled",
                "id": "inc4-t2",
                "text": "14:05 UTC — Identified",
                "style": {
                  "size": 14,
                  "weight": "bold",
                  "color": "#16202a"
                }
              },
              {
                "kind": "text",
                "id": "inc4-t2-body",
                "text": "A point of presence added the previous evening was serving cold. Every miss fell through to the origin."
              },
              {
                "kind": "styled",
                "id": "inc4-t3",
                "text": "14:09 UTC — Monitoring",
                "style": {
                  "size": 14,
                  "weight": "bold",
                  "color": "#16202a"
                }
              },
              {
                "kind": "text",
                "id": "inc4-t3-body",
                "text": "Traffic shifted away from the cold pop. Latency returned to baseline within ninety seconds."
              },
              {
                "kind": "styled",
                "id": "inc4-t4",
                "text": "14:14 UTC — Resolved",
                "style": {
                  "size": 14,
                  "weight": "bold",
                  "color": "#16202a"
                }
              },
              {
                "kind": "text",
                "id": "inc4-t4-body",
                "text": "The pop was returned to rotation behind a cache warmer. Total impact: twelve minutes."
              }
            ],
            "style": {
              "background": "#f5f7f9",
              "border": "#dde3ea",
              "radius": 10,
              "padding": 18
            }
          },
          {
            "kind": "spacer",
            "id": "inc4-follow-gap",
            "height": 18
          },
          {
            "kind": "styled",
            "id": "inc4-follow-title",
            "text": "Follow-up",
            "style": {
              "size": 16,
              "weight": "bold",
              "color": "#16202a"
            }
