                    "kind": "styled",
                    "id": "inc-4-title",
                    "text": "INC-4 Elevated API latency",
                    "style": {
                      "size": 15,
                      "weight": "bold",
                      "color": "#16202a"
                    }
                  },
                  {
                    "kind": "styled",
                    "id": "inc-4-when",
                    "text": "2026-02-19 · 12 minutes",
                    "style": {
                      "size": 12,
                      "color": "#5d6b79"
                    }
                  }
                ],
                "gap": 10,
                "align": "center"
              },
              {
                "kind": "text",
                "id": "inc-4-body",
                "text": "p99 latency on the Atlas API rose to eleven seconds after a cold cache on a newly added point of presence. Traffic recovered once the cache warmed."
              },
              {
                "kind": "link",
                "id": "inc-4-more",
                "text": "Full timeline",
                "url": "/incidents/inc-4"
              }
