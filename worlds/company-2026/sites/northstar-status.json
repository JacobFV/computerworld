          {
            "kind": "styled",
            "id": "subscribe-title",
            "text": "Get notified",
            "style": {
              "size": 16,
              "weight": "bold",
              "color": "#16202a"
            }
          },
          {
            "kind": "text",
            "id": "subscribe-body",
            "text": "We send one mail per incident, and nothing else."
          },
          {
            "kind": "form",
            "id": "subscribe",
            "action": {
              "method": "POST",
              "url": "/api/records/subscriber",
              "fields": {
                "email": "$subscribe-email"
              }
            },
            "children": [
              {
                "kind": "input",
                "id": "subscribe-email",
                "label": "Email address",
                "value": "",
                "placeholder": ""
              },
              {
                "kind": "button",
                "id": "subscribe-submit",
                "text": "Submit",
                "action": {
                  "method": "POST",
                  "url": "/api/records/subscriber",
                  "fields": {
                    "email": "$subscribe-email"
                  }
                }
              }
            ]
          },
          {
            "kind": "link",
            "id": "subscribe-records",
            "text": "Who is subscribed",
            "url": "/records"
          }
