          {
            "kind": "text",
            "id": "summary",
            "text": "A deterministic clock and scheduler for tests: time moves only when you advance it."
          },
          {
            "kind": "text",
            "id": "meta",
            "text": "License: MIT · Author: Northstar · Requires: Python >=3.9 · Latest release: 0.6.2 (2026)"
          },
          {
            "kind": "heading",
            "id": "desc-h",
            "text": "Project description",
            "level": 2
          },
          {
            "kind": "text",
            "id": "desc",
            "text": "clockwork-det replaces time.time, time.monotonic and asyncio's loop time with a logical clock. advance(seconds) moves it and runs any callbacks due, in due-time then registration order. A context manager installs it for a block. The asyncio integration makes sleep() instantaneous and ordered."
          },
          {
            "kind": "text",
            "id": "rh",
            "text": "Release history: 0.6.2 (latest), 0.6.0, 0.5.3"
