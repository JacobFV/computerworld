          },
          {
            "kind": "text",
            "id": "meta",
            "text": "License: Apache-2.0 · Author: Northstar · Requires: Python >=3.9 · Latest release: 1.8.0 (2026)"
          },
          {
            "kind": "heading",
            "id": "desc-h",
            "text": "Project description",
            "level": 2
          },
          {
            "kind": "text",
            "id": "desc",
            "text": "atlas-sdk wraps the Atlas HTTP protocol in a small typed client. Create a world from a seed, step it by ticks, read any machine's screen or file system, and diff two runs. Calls are serialised so a run is reproducible from the seed and the call order. The package ships an in-process stub server for tests."
          },
          {
            "kind": "text",
            "id": "rh",
            "text": "Release history: 1.8.0 (latest), 1.7.2, 1.7.0, 1.6.1"
