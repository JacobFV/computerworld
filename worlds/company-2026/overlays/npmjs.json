          },
          {
            "kind": "styled",
            "id": "install",
            "text": "npm i json-diff-lite",
            "style": {
              "mono": true,
              "size": 13,
              "padding": 8,
              "background": "#f4f4f4",
              "radius": 4
            }
          },
          {
            "kind": "text",
            "id": "meta",
            "text": "Version 1.3.1 · License MIT · 620,000 weekly downloads · Maintainer p-raman · Published 2026"
          },
          {
            "kind": "heading",
            "id": "readme-h",
            "text": "README",
            "level": 2
          },
          {
            "kind": "text",
            "id": "readme",
            "text": "json-diff-lite compares two JSON values and returns the smallest list of add, remove and replace operations that turns one into the other. Arrays are diffed by index; objects by key, in sorted order, so the patch is stable across runs. apply() takes a patch and returns a new value."
          },
          {
            "kind": "styled",
            "id": "example",
            "text": "import {diff, apply} from 'json-diff-lite';\nconst patch = diff({a: 1}, {a: 2, b: 3});\n// [{op: 'replace', path: '/a', value: 2}, {op: 'add', path: '/b', value: 3}]\napply({a: 1}, patch); // {a: 2, b: 3}",
            "style": {
              "mono": true,
              "size": 13,
              "padding": 8,
              "background": "#f4f4f4",
              "radius": 4
            }
          },
          {
            "kind": "heading",
            "id": "deps-h",
