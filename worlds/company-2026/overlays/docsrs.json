          },
          {
            "kind": "text",
            "id": "m-1",
            "text": "replaylog::replay — replaying call logs"
          },
          {
            "kind": "text",
            "id": "m-2",
            "text": "replaylog::diff — reporting divergence"
          },
          {
            "kind": "heading",
            "id": "i-h",
            "text": "Items",
            "level": 2
          },
          {
            "kind": "text",
            "id": "i-0",
            "text": "struct Recorder — Appends inputs to a log."
          },
          {
            "kind": "text",
            "id": "i-1",
            "text": "struct Replayer — Feeds a log back and checks outputs."
          },
          {
            "kind": "text",
            "id": "i-2",
            "text": "struct Divergence — The tick, expected and actual output where a replay first differed."
