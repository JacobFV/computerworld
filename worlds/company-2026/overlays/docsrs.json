            "text": "A logical clock that only moves when advanced. Timers fire in due order, then registration order."
          },
          {
            "kind": "styled",
            "id": "use",
            "text": "[dependencies]\ndetclock = \"0.4.0\"",
            "style": {
              "mono": true,
