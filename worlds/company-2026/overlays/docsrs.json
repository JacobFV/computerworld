          {
            "kind": "heading",
            "id": "name",
            "text": "Crate hashseed 0.2.1",
            "level": 1
          },
          {
            "kind": "text",
            "id": "desc",
            "text": "Seeded, splittable pseudo-random streams (PCG) that give the same numbers on every platform."
          },
          {
            "kind": "styled",
            "id": "use",
            "text": "[dependencies]\nhashseed = \"0.2.1\"",
            "style": {
              "mono": true,
              "size": 13,
              "padding": 8,
              "background": "#f4f4f4",
              "radius": 4
            }
          },
          {
            "kind": "text",
            "id": "meta",
            "text": "MIT · owner northstar · built with the nightly toolchain on 2026-09-18 for x86_64-unknown-linux-gnu · build passing"
          },
          {
            "kind": "link",
            "id": "crate",
            "text": "crates.io/crates/hashseed",
            "url": "http://crates.io/crates/hashseed"
          },
          {
            "kind": "text",
            "id": "readme",
            "text": "hashseed derives independent random streams from one root seed by hashing a name into a stream id, so a simulation can hand each component its own reproducible generator. The algorithm is PCG-XSH-RR with a fixed increment; the output is stable across versions of this crate, which is a documented promise."
          },
          {
            "kind": "heading",
            "id": "m-h",
            "text": "Modules",
            "level": 2
          },
          {
            "kind": "text",
            "id": "m-0",
            "text": "hashseed::rng — the generator"
          },
          {
            "kind": "text",
            "id": "m-1",
            "text": "hashseed::split — named child streams"
          },
          {
            "kind": "text",
            "id": "m-2",
            "text": "hashseed::distr — ranges and choices"
          },
          {
            "kind": "heading",
            "id": "i-h",
            "text": "Items",
            "level": 2
          },
          {
            "kind": "text",
            "id": "i-0",
            "text": "struct Rng — A PCG generator; next_u64(), range(), choose()."
          },
          {
            "kind": "text",
            "id": "i-1",
            "text": "fn split — Derives a child generator from a parent and a name."
          },
          {
            "kind": "text",
            "id": "i-2",
            "text": "fn fnv1a64 — The hash used to turn names into stream ids."
          },
          {
            "kind": "heading",
            "id": "d-h",
            "text": "Dependencies",
            "level": 2
          },
          {
            "kind": "text",
            "id": "d-none",
            "text": "None."
          },
          {
            "kind": "link",
            "id": "repo",
            "text": "Repository on GitHub",
            "url": "http://github.com/"
          }
        ]
      },
