          {
            "kind": "heading",
            "id": "name",
            "text": "Crate ordmap 2.1.0",
            "level": 1
          },
          {
            "kind": "text",
            "id": "desc",
            "text": "Insertion-ordered map and set with stable iteration, for outputs that must not depend on hash order."
          },
          {
            "kind": "styled",
            "id": "use",
            "text": "[dependencies]\nordmap = \"2.1.0\"",
            "style": {
              "mono": true,
              "size": 13,
              "padding": 8,
              "background": "#f4f4f4",
              "radius": 4
            }
          },
          {
            "kind": "text",
            "id": "meta",
            "text": "MIT OR Apache-2.0 · owner praman · built with the nightly toolchain on 2026-09-18 for x86_64-unknown-linux-gnu · build passing"
          },
          {
            "kind": "link",
            "id": "crate",
            "text": "crates.io/crates/ordmap",
            "url": "http://crates.io/crates/ordmap"
          },
          {
            "kind": "text",
            "id": "readme",
            "text": "ordmap keeps entries in insertion order and iterates them that way, however they were hashed, so a serialised map or a log line is the same on every platform and every run. Lookup is a hash index over a vector. It is the map to reach for when iteration order can reach an output."
          },
          {
            "kind": "heading",
            "id": "m-h",
            "text": "Modules",
            "level": 2
          },
          {
            "kind": "text",
            "id": "m-0",
            "text": "ordmap::map — the map type"
          },
          {
            "kind": "text",
            "id": "m-1",
            "text": "ordmap::set — the set type"
          },
          {
            "kind": "text",
            "id": "m-2",
            "text": "ordmap::entry — the entry API"
          },
          {
            "kind": "heading",
            "id": "i-h",
            "text": "Items",
            "level": 2
          },
          {
            "kind": "text",
            "id": "i-0",
            "text": "struct OrdMap — An insertion-ordered hash map."
          },
          {
            "kind": "text",
            "id": "i-1",
            "text": "struct OrdSet — An insertion-ordered hash set."
          },
          {
            "kind": "text",
            "id": "i-2",
            "text": "enum Entry — Occupied or Vacant, as in std."
