            "kind": "text",
            "id": "m-0",
            "text": "atlas_sim::client — the client"
          },
          {
            "kind": "text",
            "id": "m-1",
            "text": "atlas_sim::world — a running world"
          },
          {
            "kind": "text",
            "id": "m-2",
            "text": "atlas_sim::machine — a machine in a world"
          },
          {
            "kind": "text",
            "id": "m-3",
            "text": "atlas_sim::replay — replaying call logs"
          },
          {
            "kind": "heading",
            "id": "i-h",
            "text": "Items",
            "level": 2
          },
          {
            "kind": "text",
            "id": "i-0",
            "text": "struct Atlas — A connection to an Atlas server."
          },
          {
            "kind": "text",
            "id": "i-1",
            "text": "struct World — A running world; step(), machine() and snapshot()."
          },
          {
            "kind": "text",
            "id": "i-2",
            "text": "fn replay — Re-runs a recorded call log against a fresh world and diffs the result."
          },
          {
