{
  "name": "sensor-gateway",
  "version": "0.2.0",
  "description": "Ingests Atlas sensor-node readings, keeps them in a JSON store and reports aggregates and alerts",
  "main": "src/gateway.js",
  "bin": {
    "gateway": "src/gateway.js"
  },
  "scripts": {
